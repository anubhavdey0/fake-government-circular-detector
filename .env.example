# Copy to .env and fill in what you use. Every setting is optional.

# Public address, for HTTPS (compose --profile https) and for receipt links in bot replies.
CIRCVERIFY_DOMAIN=verify.example.org
CIRCVERIFY_PUBLIC_URL=https://verify.example.org

# WhatsApp bot (Meta WhatsApp Cloud API). Served at https://<domain>/whatsapp/webhook when all four are set.
CIRCVERIFY_WHATSAPP_TOKEN=
CIRCVERIFY_WHATSAPP_PHONE_ID=
CIRCVERIFY_WHATSAPP_VERIFY_TOKEN=
CIRCVERIFY_WHATSAPP_APP_SECRET=
# CIRCVERIFY_WHATSAPP_API_VERSION=v23.0

# Telegram bot (compose --profile telegram).
CIRCVERIFY_TELEGRAM_TOKEN=

# OCR: Tesseract (installed in the image) is used automatically. RapidOCR is an alternative.
# CIRCVERIFY_OCR_ENGINE=tesseract

# Limits for a public server (compose sets these defaults): checks per address as count/seconds,
# and how many checks may run or wait at once before new ones are told to try again.
# CIRCVERIFY_RATE_LIMIT=30/600
# CIRCVERIFY_MAX_WAITING=6

# Digital signatures are checked against the CCA India roots bundled with the package. Extra roots
# can be added here, separated by ":" on Linux.
# CIRCVERIFY_TRUST_ROOTS=/data/roots/extra-root.cer
